rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Личные данные и тест синхронизации: только владелец
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Проекты: видят и меняют только участники (список memberUids в документе проекта).
    // Точки, дни, записи и т.д. лежат внутри проекта как подколлекции.
    match /projects/{projectId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberUids;
      allow read, update: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow delete: if false; // удаление только «мягкое» (флаг в документе)

      match /{sub}/{docId=**} {
        allow read, write: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberUids;
      }
    }
  }
}
